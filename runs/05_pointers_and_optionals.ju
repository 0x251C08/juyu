//! Safe non-null pointers, zero-cost optionals, and null-coalescing in Juyu.

pub struct UserProfile {
    displayName: []const u8,
    avatarUrl: ?[]const u8,
}

pub struct User {
    id: u64,
    profile: ?UserProfile,
}

pub fn main(): !void {
    std.io.println(msg: "--- Pointers & Optionals Demo ---");

    // 1. Safe non-null pointer:
    var number: i32 = 42;
    let ptr: *i32 = &number;
    ptr.* += 8; // Postfix dereference operator
    std.io.println(msg: $"Updated value via pointer: {ptr.*}");

    // 2. Zero-cost nullable pointer:
    var maybePtr: ?*i32 = null;

    if (let active = maybePtr) {
        active.* = 100;
    } else {
        std.io.println(msg: "maybePtr is currently null");
    }

    // Assign active pointer:
    maybePtr = ptr;
    if (let active = maybePtr) {
        std.io.println(msg: $"Unwrapped active pointer successfully: {active.*}");
    }

    // 3. Optional structs and null-coalescing (??):
    let user = User {
        .id = 1001,
        .profile = null,
    };

    let name = user.profile?.displayName ?? "Guest User";
    std.io.println(msg: $"Resolved username: {name}");
}
