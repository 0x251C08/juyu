//! Explicit allocators, Arena memory, and dynamic collections in Juyu.

export fn main(): !void {
    std.io.println("--- Memory & Allocators Showcase ---");

    // 1. General Purpose Allocator with leak detection:
    var gpa := std.heap.GeneralPurposeAllocator.init();
    defer {
        if (!gpa.deinit()) {
            std.io.println("ERROR: Memory leak in GPA!");
        } else {
            std.io.println("GPA clean teardown: 0 leaks detected.");
        }
    };
    let baseAlloc := gpa.allocator();

    // 2. Arena Allocator wrapping GPA:
    var arena := std.heap.ArenaAllocator.init(baseAlloc);
    defer arena.deinit(); // Frees all arena allocations at once
    let arenaAlloc := arena.allocator();

    // 3. Dynamic ArrayList storing its own Allocator:
    var list := std.heap.ArrayList<i32>.init(arenaAlloc)!;
    defer list.deinit();

    for (var i := 1; i <= 5; i += 1) {
        list.append(i * 10)!;
    }

    std.io.println($"List count: {list.len()}");
    std.io.printlnInt(list.get(2).* as i64);
}
