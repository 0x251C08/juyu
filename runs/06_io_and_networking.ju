//! I/O streams, capability filesystem, networking, and high-resolution timers.

export fn main(): !void {
    std.io.println("--- Juyu I/O, Filesystem & Network Demo ---");

    // 1. High-resolution timer:
    let start := std.time.Instant.now();

    // 2. Capability-based filesystem operations:
    let dir := std.fs.cwd();
    std.io.println("Accessed current working directory via capability handle.");

    // 3. Network address parsing:
    let addr := std.net.Address.parseIp4("127.0.0.1", 8080)!;
    std.io.println($"Parsed IPv4 address: port {addr.port}");

    // 4. Time measurement:
    let elapsed := start.elapsed();
    std.io.println($"Operation completed in {elapsed.toMillis()} milliseconds.");
}
