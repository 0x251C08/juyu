//! Structs, methods, structural interfaces, and composition in Juyu.

export struct Entity {
    id: u64,
    x: f32,
    y: f32,
}

export struct Player {
    Entity, // Anonymous embedding: promotes fields and methods
    name: &[const u8],
    health: i32,

    export static fn init(id: u64, name: &[const u8]): Player {
        => Player {
            Entity: Entity { id: id, x: 0.0, y: 0.0 },
            name: name,
            health: 100,
        };
    }

    export fn takeDamage(&mut self, amount: i32) {
        self.health -= amount;
        if (self.health < 0) {
            self.health = 0;
        }
    }
}

// Structural interface satisfied automatically by any struct with matching method
export interface Describable {
    fn describe(&self): &[const u8];
}

extend Player {
    export fn describe(&self): &[const u8] {
        => self.name;
    }
}

export fn printDescription(item: any Describable) {
    std.io.println(item.describe());
}

export fn main(): !void {
    var p := Player.init(1, "Hero");
    p.takeDamage(25);

    // Access promoted Entity field directly:
    let entityId := p.id;

    printDescription(p);
    std.io.println("Player initialized and took damage.");
}
