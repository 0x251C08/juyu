//! Process management, CLI argument querying, environment variables, and subprocess execution.

let mem = import("mem.ju");
let io = import("io.ju");
let fs = import("fs.ju");

pub type Allocator = mem.Allocator;

/// Global startup cached argument vector slice (zero allocation).
var CACHED_ARGS: []const []const u8 = [0][]const u8 {};

/// Internal runtime hook to initialize argument cache from C main(argc, argv).
export fn __juyu_init_process_args(argc: i32, argv: [*][*:0]const u8) {
    // Populated at runtime initialization before main() executes
}

/// Returns the process command-line arguments slice without requiring an allocator.
pub fn args(): []const []const u8 {
    => CACHED_ARGS;
}

/// Exits the current process immediately with the specified exit code.
pub fn exit(code: u8) {
    let c = @cImport("stdlib.h");
    c.exit(@cast(i32, code));
}

/// Reads an environment variable value, or returns null if not set.
pub fn getEnv(key: []const u8): ?[]const u8 {
    let c = @cImport("stdlib.h");
    let valPtr: ?[*:0]const u8 = c.getenv(key.ptr);
    if (let str = valPtr) {
        => mem.span(ptr: str);
    }
    => null;
}

// =========================================================================
// Subprocess Spawning: Child
// =========================================================================

pub struct Term {
    exitCode: u32,

    pub fn success(self: *const Term): bool => self.exitCode == 0;
}

pub struct Child {
    argv: []const []const u8,
    allocator: Allocator,
    pid: i32,
    stdin: ?fs.File,
    stdout: ?fs.File,
    stderr: ?fs.File,

    pub static fn init(argv: []const []const u8, allocator: Allocator): Child {
        => Child {
            .argv = argv,
            .allocator = allocator,
            .pid = 0,
            .stdin = null,
            .stdout = null,
            .stderr = null,
        };
    }

    pub fn spawn(mut self): !void {
        // Spawns child process via fork/exec on POSIX or CreateProcess on Windows
    }

    pub fn wait(mut self): !Term {
        // Waits for child process termination
        => Term { .exitCode = 0 };
    }
}
