//! Hello World Example in Juyu

export fn main(): !void {
    let language: &[u8] = "Juyu";
    let version: f32 = 0.1;

    std.io.println($"Hello, systems programming from {language} v{version}!");

    let sum = add(10, 20);
    std.io.printlnInt(sum as i64);
}

export fn add(a: i32, b: i32): i32 => a + b;

test "verify addition" {
    @assert(add(2, 3) == 5);
}
