//! Memory management, safe non-null pointers, and optionals in Juyu.

export struct Vector3 {
    x: f32,
    y: f32,
    z: f32,

    export static fn init(x: f32, y: f32, z: f32): Vector3 {
        => Vector3 { x: x, y: y, z: z };
    }

    export fn lengthSquared(&self): f32 {
        => self.x * self.x + self.y * self.y + self.z * self.z;
    }
}

export fn main(allocator: std.mem.Allocator): !void {
    // 1. Explicit allocator with leak detection:
    var gpa = std.heap.GeneralPurposeAllocator.init();
    defer {
        if (!gpa.deinit()) {
            std.io.println("Memory leak detected!");
        }
    };
    let alloc = gpa.allocator();

    // 2. Dynamic list with explicit allocator:
    var numbers = std.heap.ArrayList<i32>.init(alloc)!;
    defer numbers.deinit();

    numbers.append(100)!;
    numbers.append(200)!;
    numbers.append(300)!;

    // 3. Pointers and Optionals:
    let val: i32 = 42;
    let safe_ptr: *const i32 = &val;

    var maybe_ptr: ?*i32 = null;

    if (let active = maybe_ptr) {
        active.* += 1;
    } else {
        std.io.println("Optional pointer is safely null");
    }

    // 4. Struct instantiation and method call:
    let v = Vector3.init(1.0, 2.0, 3.0);
    let lenSq = v.lengthSquared();

    // 5. Demonstrating errdefer and match:
    perform_operation(alloc)!;

    std.io.println("Memory and pointer demo completed successfully.");
}

export fn perform_operation(allocator: std.mem.Allocator): !void {
    let temp_buffer = std.heap.PageAllocator.alloc(u8, 1024)!;
    errdefer std.heap.PageAllocator.free(temp_buffer);

    let status = match (temp_buffer.len) {
        0..10 => "Too small",
        1024 => "Exact fit",
        _ => "Other size",
    };
    
    std.io.println($"Buffer status: {status}");
}
